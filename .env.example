# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Fundación PRO-21
# Copiar a .env.local y completar los valores reales.
# NUNCA subir .env.local a GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── URL del sitio (sin barra al final) ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fundacionpro21.org

# ── Cloudflare R2 — NO SE USA EN v1 ─────────────────────────────────────────
# Las fotos se guardan en el repositorio (public/images/uploads) y los PDFs en public/docs.
# No hace falta cuenta de Cloudflare ni estas variables. Quedan comentadas como referencia por si el repositorio
# crece y se decide migrar (ver docs/entrega/MANUAL-ADMIN.md §6 y docs/ARCHITECTURE.md).
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=pro21-media
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Resend — Formulario de contacto ──────────────────────────────────────────
# Obtener en: resend.com → API Keys
# Plan gratuito: 3.000 emails/mes, 100/día
# OBLIGATORIA en producción: sin ella, los formularios responden con error (503).
RESEND_API_KEY=

# ── Correo: destino y remitente de los formularios (contacto y voluntariado) ──
# Destino: si se deja VACÍO, se usa el correo de Configuración general del CMS
# (content/settings/site_settings.yml → contact.email). Solo definirlo para sobrescribirlo.
CONTACT_EMAIL=
# Remitente: debe ser una dirección de un dominio VERIFICADO en Resend
# (ver docs/entrega/GUIA-DOMINIO.md). Sin dominio verificado, Resend rechaza el envío
# y el sitio muestra un error con alternativa de WhatsApp (nunca finge éxito).
CONTACT_FROM=web@fundacionpro21.org

# ── Analytics (opcional — decidir con la fundación) ──────────────────────────
# Google Analytics 4: obtener en analytics.google.com
NEXT_PUBLIC_GA_ID=

# Vercel Analytics: se activa automáticamente en el dashboard de Vercel
# No requiere variable de entorno adicional

# ── GitHub OAuth — login del panel /admin en producción ──────────────────────
# Función propia en app/api/auth (Vercel Function, costo $0 — ver docs/CMS_DEVELOPMENT_PLAN.md §7).
# 1. Crear una OAuth App en: https://github.com/settings/developers
# 2. Authorization callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback
# 3. Copiar Client ID / Client Secret abajo (y como variables de entorno en Vercel, NUNCA en el repo)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Sitio de prueba sin indexar ──────────────────────────────────────────────
# SITE_NOINDEX=1 → robots.txt con "Disallow: /" y cabecera X-Robots-Tag: noindex.
# Usar en el deploy de prueba (.vercel.app). QUITAR (dejar vacío) al lanzar el sitio.
SITE_NOINDEX=
