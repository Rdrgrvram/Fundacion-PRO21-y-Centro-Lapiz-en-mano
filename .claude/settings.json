{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/recordar-codex.mjs\"",
            "timeout": 15,
            "statusMessage": "Revisando si conviene delegar a Codex..."
          }
        ]
      }
    ]
  }
}
